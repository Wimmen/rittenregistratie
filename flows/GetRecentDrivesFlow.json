{
    "Id": null,
    "Name": "GetRecentDrivesFlow",
    "Version": "1.0",
    "Status": "Active",
    "StartStepId": "get-drives-step",
    "ErrorStepId": "error-to-user-step",
    "Steps": {
        "get-drives-step": {
            "Id": "get-drives-step",
            "Type": "QueryDatabase",
            "Parameters": {
                "QueryType": "Select",
                "QueryTextType": "Text",
                "Query": "SELECT Id as id, DriveDate as date, FromLocation as [from], ToLocation as [to], Mileage as mileage, Mileage - LAG(Mileage, 1, 0) OVER (PARTITION BY UserId ORDER BY Mileage ASC) as distance, Type as type, Description as description FROM Drives WHERE UserId = @UserId ORDER BY Mileage DESC OFFSET @Offset ROWS FETCH NEXT @Limit ROWS ONLY",
                "Parameters": {
                    "UserId": "${principal.userId}",
                    "Offset": "${COALESCE(event.data.Offset, 0)}",
                    "Limit": "${COALESCE(event.data.Limit, 20)}"
                }
            },
            "Alias": "RecentDrives",
            "NextStepId": "send-list-step",
            "AuthenticationId": 0
        },
        "send-list-step": {
            "Id": "send-list-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "RecentDrivesList",
                "Data": "${RecentDrives}"
            },
            "NextStepId": null
        },
        "error-to-user-step": {
            "Id": "error-to-user-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "GetRecentDrivesFailed",
                "Data": {
                    "Message": "Failed to retrieve drives",
                    "Status": "Failed",
                    "Error": "${error}"
                }
            },
            "NextStepId": null
        }
    },
    "Events": [
        {
            "Id": null,
            "Name": "GetRecentDrives",
            "Version": "1.0",
            "Status": "Active",
            "Roles": [
                "User"
            ],
            "Validation": []
        }
    ]
}