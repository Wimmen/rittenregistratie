{
    "Id": null,
    "Name": "UpdateDriveFlow",
    "Version": "1.0",
    "Status": "Active",
    "StartStepId": "update-drive-step",
    "ErrorStepId": "error-to-user-step",
    "Steps": {
        "update-drive-step": {
            "Id": "update-drive-step",
            "Type": "QueryDatabase",
            "Parameters": {
                "QueryType": "Update",
                "QueryTextType": "Text",
                "Query": "UPDATE Drives SET DriveDate = @DriveDate, FromLocation = @FromLocation, ToLocation = @ToLocation, Mileage = @Mileage, Type = @Type, Description = @Description WHERE Id = @Id AND UserId = @UserId",
                "Parameters": {
                    "Id": "${event.data.id}",
                    "DriveDate": "${event.data.date}",
                    "FromLocation": "${event.data.from}",
                    "ToLocation": "${event.data.to}",
                    "Mileage": "${event.data.mileage}",
                    "Type": "${event.data.type}",
                    "UserId": "${principal.userId}",
                    "Description": "${event.data.description}"
                }
            },
            "Alias": "DriveUpdated",
            "NextStepId": "success-to-user-step",
            "AuthenticationId": 0
        },
        "success-to-user-step": {
            "Id": "success-to-user-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "DriveUpdated",
                "Data": {
                    "Message": "Drive Updated Successfully",
                    "Status": "Success"
                }
            },
            "NextStepId": null
        },
        "error-to-user-step": {
            "Id": "error-to-user-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "DriveUpdateFailed",
                "Data": {
                    "Message": "Drive Update Failed",
                    "Status": "Failed",
                    "Error": "${error}"
                }
            },
            "NextStepId": null
        }
    },
    "Events": [
        {
            "Id": null,
            "Name": "UpdateDrive",
            "Version": "1.0",
            "Status": "Active",
            "Roles": [
                "User"
            ],
            "Validation": [
                {
                    "Check": "${NOT(EMPTY(event.data.id))}",
                    "Message": "Rit ID is verplicht"
                },
                {
                    "Check": "${NOT(EMPTY(event.data.date))}",
                    "Message": "Datum is verplicht"
                },
                {
                    "Check": "${NOT(EMPTY(event.data.from))}",
                    "Message": "Van is verplicht"
                },
                {
                    "Check": "${NOT(EMPTY(event.data.to))}",
                    "Message": "Naar is verplicht"
                },
                {
                    "Check": "${NOT(EMPTY(event.data.mileage))}",
                    "Message": "Kilometerstand is verplicht"
                }
            ]
        }
    ]
}