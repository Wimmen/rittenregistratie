{
    "Id": null,
    "Name": "UpdateDriveFlow",
    "Version": "1.0",
    "Status": "Active",
    "StartStepId": "update-drive-step",
    "ErrorStepId": "error-to-user-step",
    "Steps": {
        "update-drive-step": {
            "Id": "update-drive-step",
            "Type": "QueryDatabase",
            "Parameters": {
                "QueryType": "Update",
                "QueryTextType": "Text",
                "Query": "UPDATE Drives SET DriveDate = @DriveDate, FromLocation = @FromLocation, ToLocation = @ToLocation, Mileage = @Mileage, Distance = @Distance, Type = @Type, Description = @Description WHERE Id = @Id AND UserId = @UserId",
                "Parameters": {
                    "Id": "${event.id}",
                    "DriveDate": "${event.date}",
                    "FromLocation": "${event.from}",
                    "ToLocation": "${event.to}",
                    "Mileage": "${event.mileage}",
                    "Distance": "${event.distance}",
                    "Type": "${event.type}",
                    "UserId": "${principal.userId}",
                    "Description": "${event.description}"
                }
            },
            "Alias": "DriveUpdated",
            "NextStepId": "success-to-user-step",
            "ConnectionId": 0
        },
        "success-to-user-step": {
            "Id": "success-to-user-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "DriveUpdated",
                "Data": {
                    "Message": "Drive Updated Successfully",
                    "Status": "Success"
                }
            },
            "NextStepId": null
        },
        "error-to-user-step": {
            "Id": "error-to-user-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "DriveUpdateFailed",
                "Data": {
                    "Message": "Drive Update Failed",
                    "Status": "Failed",
                    "Error": "${error}"
                }
            },
            "NextStepId": null
        }
    },
    "Events": [
        {
            "Id": null,
            "Name": "UpdateDrive",
            "Version": "1.0",
            "Status": "Active",
            "Validation": "[event.id NOT EMPTY, event.date NOT EMPTY, event.from NOT EMPTY, event.to NOT EMPTY, event.mileage NOT EMPTY, principal.userId NOT EMPTY]"
        }
    ]
}