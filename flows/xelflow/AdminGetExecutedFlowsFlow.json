{
    "Id": null,
    "Name": "AdminGetExecutedFlowsFlow",
    "Version": "1.0",
    "Status": "Active",
    "StartStepId": "get-executed-flows-step",
    "ErrorStepId": "error-step",
    "Steps": {
        "get-executed-flows-step": {
            "Id": "get-executed-flows-step",
            "Type": "QueryDatabase",
            "Parameters": {
                "QueryType": "Select",
                "QueryTextType": "Dynamic",
                "Query": [
                    {
                        "Sql": "SELECT Flows.Name, ExecutedFlows.Id, ExecutedFlows.Start, DATEDIFF(millisecond, ExecutedFlows.Start, ExecutedFlows.LastUpdated) as Duration, ExecutedFlows.UserId, ExecutedFlows.Status",
                        "Part": "Select"
                    },
                    {
                        "Sql": "FROM ExecutedFlows INNER JOIN Flows ON ExecutedFlows.FlowId = Flows.Id",
                        "Part": "From"
                    },
                    {
                        "Sql": "WHERE Flows.Name LIKE @Search",
                        "Part": "Where",
                        "Conditions": "@Search != %%"
                    },
                    {
                        "Sql": "ORDER BY ExecutedFlows.Id DESC",
                        "Part": "OrderBy"
                    },
                    {
                        "Sql": "OFFSET @Offset ROWS FETCH NEXT @Limit ROWS ONLY",
                        "Part": "Limit"
                    }
                ],
                "Parameters": {
                    "Search": "%${event.data.search}%",
                    "Offset": "${event.data.offset}",
                    "Limit": "${event.data.limit}"
                }
            },
            "Alias": "executedFlows",
            "NextStepId": "count-executed-flows-step",
            "AuthenticationId": 0
        },
        "count-executed-flows-step": {
            "Id": "count-executed-flows-step",
            "Type": "QueryDatabase",
            "Parameters": {
                "QueryType": "Select",
                "QueryTextType": "Dynamic",
                "Query": [
                    {
                        "Sql": "SELECT COUNT(*) as Total",
                        "Part": "Select"
                    },
                    {
                        "Sql": "FROM ExecutedFlows INNER JOIN Flows ON ExecutedFlows.FlowId = Flows.Id",
                        "Part": "From"
                    },
                    {
                        "Sql": "WHERE Flows.Name LIKE @Search",
                        "Part": "Where",
                        "Conditions": "@Search != %%"
                    }
                ],
                "Parameters": {
                    "Search": "%${event.data.search}%"
                }
            },
            "Alias": "count",
            "NextStepId": "send-executed-flows-step",
            "AuthenticationId": 0
        },
        "send-executed-flows-step": {
            "Id": "send-executed-flows-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "AdminExecutedFlowsList",
                "Data": {
                    "Items": "${executedFlows}",
                    "Total": "${count.0.Total}",
                    "Offset": "${event.data.offset}",
                    "Limit": "${event.data.limit}"
                }
            },
            "NextStepId": null
        },
        "error-step": {
            "Id": "error-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "AdminExecutedFlowsListFailed",
                "Data": {
                    "Message": "Failed to retrieve executed flows",
                    "Status": "Failed",
                    "Error": "${error}"
                }
            },
            "NextStepId": null
        }
    },
    "Events": [
        {
            "Id": null,
            "Name": "AdminGetExecutedFlows",
            "Version": "1.0",
            "Status": "Active",
            "Roles": [
                "Admin"
            ],
            "Validation": []
        }
    ]
}