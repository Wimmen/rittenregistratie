{
    "Id": null,
    "Name": "AdminGetUserFlow",
    "Version": "1.0",
    "Status": "Active",
    "StartStepId": "get-user-step",
    "ErrorStepId": "error-step",
    "Steps": {
        "get-user-step": {
            "Id": "get-user-step",
            "Type": "QueryDatabase",
            "Parameters": {
                "QueryType": "Select",
                "QueryTextType": "Text",
                "Query": "SELECT u.*, STRING_AGG(r.Name, ', ') AS Roles FROM Users u LEFT JOIN UserRoles ur ON u.Id = ur.UserId LEFT JOIN Roles r ON ur.RoleId = r.Id WHERE u.Id = @Id GROUP BY u.Id, u.FirstName, u.LastName, u.Email, u.LastLogin, u.Oid, u.Disabled",
                "Parameters": {
                    "Id": "${event.id}"
                }
            },
            "Alias": "user",
            "NextStepId": "send-user-step",
            "AuthenticationId": 0
        },
        "send-user-step": {
            "Id": "send-user-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "AdminUserLoaded",
                "Data": "${user}"
            },
            "NextStepId": null
        },
        "error-step": {
            "Id": "error-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "AdminGetUserFailed",
                "Data": {
                    "Message": "Failed to retrieve user details",
                    "Status": "Failed",
                    "Error": "${error}"
                }
            },
            "NextStepId": null
        }
    },
    "Events": [
        {
            "Id": null,
            "Name": "AdminGetUser",
            "Version": "1.0",
            "Status": "Active",
            "Roles": [
                "Admin"
            ],
            "Validation": []
        }
    ]
}