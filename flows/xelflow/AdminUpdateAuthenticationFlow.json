{
    "Id": null,
    "Name": "AdminUpdateAuthenticationFlow",
    "Version": "1.0",
    "Status": "Active",
    "Description": "Flow to update an existing authentication",
    "StartStepId": "update-auth-step",
    "ErrorStepId": "error-step",
    "Steps": {
        "update-auth-step": {
            "Id": "update-auth-step",
            "Type": "QueryDatabase",
            "Parameters": {
                "QueryType": "Update",
                "QueryTextType": "Text",
                "Query": "UPDATE Authentications SET Name = @Name, Type = @Type, Parameters = @Parameters WHERE Id = @Id",
                "Parameters": {
                    "Name": "${event.data.name}",
                    "Type": "${event.data.type}",
                    "Parameters": "${event.data.parameters}",
                    "Id": "${event.data.id}"
                }
            },
            "Alias": "updated",
            "NextStepId": "send-success-step",
            "AuthenticationId": 0
        },
        "send-success-step": {
            "Id": "send-success-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "AdminAuthenticationUpdated",
                "Data": {
                    "Message": "Authentication updated successfully",
                    "Id": "${event.data.id}",
                    "Name": "${event.data.name}"
                }
            },
            "NextStepId": null
        },
        "error-step": {
            "Id": "error-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "AdminAuthenticationUpdateFailed",
                "Data": {
                    "Message": "Failed to update authentication",
                    "Status": "Failed",
                    "Error": "${error}"
                }
            },
            "NextStepId": null
        }
    },
    "Events": [
        {
            "Id": null,
            "Name": "AdminUpdateAuthentication",
            "Version": "1.0",
            "Status": "Active",
            "Roles": [
                "Admin"
            ],
            "Validation": [
                {
                    "Check": "${NOT(EMPTY(event.id))}",
                    "Message": "Authentication Id is required"
                },
                {
                    "Check": "${NOT(EMPTY(event.name))}",
                    "Message": "Authentication name is required"
                },
                {
                    "Check": "${NOT(EMPTY(event.type))}",
                    "Message": "Authentication type is required"
                }
            ]
        }
    ]
}