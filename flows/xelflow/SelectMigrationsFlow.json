{
  "Id": null,
  "Name": "SelectMigrationsFlow",
  "Version": "1.0",
  "Status": "Active",
  "StartStepId": "select-table-step",
  "ErrorStepId": "error-to-user-step",
  "Steps": {
    "select-table-step": {
      "Id": "select-table-step",
      "Type": "QueryDatabase",
      "Parameters": {
        "Query": "SELECT * FROM Migrations"
      },
      "Alias": "Migrations",
      "NextStepId": "success-to-user-step",
      "ConnectionId": 0
    },
    "success-to-user-step": {
      "Id": "success-to-user-step",
      "Type": "SendMessageToUser",
      "Parameters": {
        "Event": "HistoryCompleted",
        "Data": "${Migrations}"
      },
      "NextStepId": null
    },
    "error-to-user-step": {
      "Id": "error-to-user-step",
      "Type": "SendMessageToUser",
      "Parameters": {
        "Event": "HistoryFailed",
        "Data": {
          "MigrationName": "SelectMigrationsFlow",
          "Message": "Select query failed",
          "Status": "Failed",
          "Error": "${error}"
        }
      },
      "NextStepId": null
    }
  },
  "Events": [
    {
      "Id": null,
      "Name": "SelectMigrations",
      "Version": "1.0",
      "Status": "Active",
      "Roles": ["Admin"],
      "Validation": []
    }
  ]
}