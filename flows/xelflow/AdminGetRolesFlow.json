{
    "Id": null,
    "Name": "AdminGetRolesFlow",
    "Version": "1.0",
    "Status": "Active",
    "StartStepId": "get-roles-step",
    "ErrorStepId": "error-step",
    "Steps": {
        "get-roles-step": {
            "Id": "get-roles-step",
            "Type": "QueryDatabase",
            "Parameters": {
                "QueryType": "Select",
                "QueryTextType": "Dynamic",
                "Query": [
                    {
                        "Sql": "SELECT *",
                        "Part": "Select"
                    },
                    {
                        "Sql": "FROM Roles",
                        "Part": "From"
                    },
                    {
                        "Sql": "WHERE Name LIKE @Search",
                        "Part": "Where",
                        "Conditions": "@Search != %%"
                    },
                    {
                        "Sql": "ORDER BY Name ASC",
                        "Part": "OrderBy"
                    },
                    {
                        "Sql": "OFFSET @Offset ROWS FETCH NEXT @Limit ROWS ONLY",
                        "Part": "Limit"
                    }
                ],
                "Parameters": {
                    "Search": "%${event.search}%",
                    "Offset": "${event.offset}",
                    "Limit": "${event.limit}"
                }
            },
            "Alias": "roles",
            "NextStepId": "count-roles-step",
            "AuthenticationId": 0
        },
        "count-roles-step": {
            "Id": "count-roles-step",
            "Type": "QueryDatabase",
            "Parameters": {
                "QueryType": "Select",
                "QueryTextType": "Dynamic",
                "Query": [
                    {
                        "Sql": "SELECT COUNT(*) as Total",
                        "Part": "Select"
                    },
                    {
                        "Sql": "FROM Roles",
                        "Part": "From"
                    },
                    {
                        "Sql": "WHERE Name LIKE @Search",
                        "Part": "Where",
                        "Conditions": "@Search != %%"
                    }
                ],
                "Parameters": {
                    "Search": "%${event.search}%"
                }
            },
            "Alias": "count",
            "NextStepId": "send-roles-step",
            "AuthenticationId": 0
        },
        "send-roles-step": {
            "Id": "send-roles-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "AdminRolesList",
                "Data": {
                    "Items": "${roles}",
                    "Total": "${count.0.Total}",
                    "Offset": "${event.offset}",
                    "Limit": "${event.limit}"
                }
            },
            "NextStepId": null
        },
        "error-step": {
            "Id": "error-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "AdminRolesListFailed",
                "Data": {
                    "Message": "Failed to retrieve roles",
                    "Status": "Failed",
                    "Error": "${error}"
                }
            },
            "NextStepId": null
        }
    },
    "Events": [
        {
            "Id": null,
            "Name": "AdminGetRoles",
            "Version": "1.0",
            "Status": "Active",
            "Roles": [
                "Admin"
            ],
            "Validation": []
        }
    ]
}