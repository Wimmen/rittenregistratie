{
    "Id": null,
    "Name": "AdminGetUsersFlow",
    "Version": "1.0",
    "Status": "Active",
    "StartStepId": "get-users-step",
    "ErrorStepId": "error-step",
    "Steps": {
        "get-users-step": {
            "Id": "get-users-step",
            "Type": "QueryDatabase",
            "Parameters": {
                "QueryType": "Select",
                "QueryTextType": "Dynamic",
                "Query": [
                    {
                        "Sql": "SELECT Users.Id, Users.FirstName, Users.LastName, Users.Email, Users.LastLogin, Users.Oid, Users.Disabled, STRING_AGG(Roles.Name, ', ') AS Roles ",
                        "Part": "Select"
                    },
                    {
                        "Sql": "FROM Users LEFT JOIN UserRoles ON Users.Id = UserRoles.UserId LEFT JOIN Roles ON UserRoles.RoleId = Roles.Id",
                        "Part": "From"
                    },
                    {
                        "Sql": "WHERE (FirstName LIKE @Search OR LastName LIKE @Search OR Email LIKE @Search)",
                        "Part": "Where",
                        "Conditions": "@Search != %%"
                    },
                    {
                        "Sql": "GROUP BY Users.Id, Users.FirstName, Users.LastName, Users.Email, Users.LastLogin, Users.Oid, Users.Disabled",
                        "Part": "GroupBy"
                    },
                    {
                        "Sql": "ORDER BY LastLogin DESC",
                        "Part": "OrderBy"
                    },
                    {
                        "Sql": "OFFSET @Offset ROWS FETCH NEXT @Limit ROWS ONLY",
                        "Part": "Limit"
                    }
                ],
                "Parameters": {
                    "Search": "%${event.search}%",
                    "Offset": "${event.offset}",
                    "Limit": "${event.limit}"
                }
            },
            "Alias": "users",
            "NextStepId": "count-users-step",
            "AuthenticationId": 0
        },
        "count-users-step": {
            "Id": "count-users-step",
            "Type": "QueryDatabase",
            "Parameters": {
                "QueryType": "Select",
                "QueryTextType": "Dynamic",
                "Query": [
                    {
                        "Sql": "SELECT COUNT(*) as Total",
                        "Part": "Select"
                    },
                    {
                        "Sql": "FROM Users",
                        "Part": "From"
                    },
                    {
                        "Sql": "WHERE (FirstName LIKE @Search OR LastName LIKE @Search OR Email LIKE @Search)",
                        "Part": "Where",
                        "Conditions": "@Search != %%"
                    }
                ],
                "Parameters": {
                    "Search": "%${event.search}%"
                }
            },
            "Alias": "count",
            "NextStepId": "send-users-step",
            "AuthenticationId": 0
        },
        "send-users-step": {
            "Id": "send-users-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "AdminUsersList",
                "Data": {
                    "Items": "${users}",
                    "Total": "${count.0.Total}",
                    "Offset": "${event.offset}",
                    "Limit": "${event.limit}"
                }
            },
            "NextStepId": null
        },
        "error-step": {
            "Id": "error-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "AdminUsersListFailed",
                "Data": {
                    "Message": "Failed to retrieve users",
                    "Status": "Failed",
                    "Error": "${error}"
                }
            },
            "NextStepId": null
        }
    },
    "Events": [
        {
            "Id": null,
            "Name": "AdminGetUsers",
            "Version": "1.0",
            "Status": "Active",
            "Roles": [
                "Admin"
            ],
            "Validation": []
        }
    ]
}