{
    "Id": null,
    "Name": "AdminGetFlowsFlow",
    "Version": "1.0",
    "Status": "Active",
    "StartStepId": "get-flows-step",
    "ErrorStepId": "error-step",
    "Steps": {
        "get-flows-step": {
            "Id": "get-flows-step",
            "Type": "QueryDatabase",
            "Parameters": {
                "QueryType": "Select",
                "QueryTextType": "Dynamic",
                "Query": [
                    {
                        "Sql": "SELECT *",
                        "Part": "Select"
                    },
                    {
                        "Sql": "FROM Flows",
                        "Part": "From"
                    },
                    {
                        "Sql": "WHERE Name LIKE @Search",
                        "Part": "Where",
                        "Conditions": "@Search != %%"
                    },
                    {
                        "Sql": "ORDER BY Name ASC",
                        "Part": "OrderBy"
                    },
                    {
                        "Sql": "OFFSET @Offset ROWS FETCH NEXT @Limit ROWS ONLY",
                        "Part": "Limit"
                    }
                ],
                "Parameters": {
                    "Search": "%${event.data.search}%",
                    "Offset": "${event.data.offset}",
                    "Limit": "${event.data.limit}"
                }
            },
            "Alias": "flows",
            "NextStepId": "count-flows-step",
            "AuthenticationId": 0
        },
        "count-flows-step": {
            "Id": "count-flows-step",
            "Type": "QueryDatabase",
            "Parameters": {
                "QueryType": "Select",
                "QueryTextType": "Dynamic",
                "Query": [
                    {
                        "Sql": "SELECT COUNT(*) as Total",
                        "Part": "Select"
                    },
                    {
                        "Sql": "FROM Flows",
                        "Part": "From"
                    },
                    {
                        "Sql": "WHERE Name LIKE @Search",
                        "Part": "Where",
                        "Conditions": "@Search != %%"
                    }
                ],
                "Parameters": {
                    "Search": "%${event.data.search}%"
                }
            },
            "Alias": "count",
            "NextStepId": "send-flows-step",
            "AuthenticationId": 0
        },
        "send-flows-step": {
            "Id": "send-flows-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "AdminFlowsList",
                "Data": {
                    "Items": "${flows}",
                    "Total": "${count.0.Total}",
                    "Offset": "${event.data.offset}",
                    "Limit": "${event.data.limit}"
                }
            },
            "NextStepId": null
        },
        "error-step": {
            "Id": "error-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "AdminFlowsListFailed",
                "Data": {
                    "Message": "Failed to retrieve flows",
                    "Status": "Failed",
                    "Error": "${error}"
                }
            },
            "NextStepId": null
        }
    },
    "Events": [
        {
            "Id": null,
            "Name": "AdminGetFlows",
            "Version": "1.0",
            "Status": "Active",
            "Roles": [
                "Admin"
            ],
            "Validation": []
        }
    ]
}