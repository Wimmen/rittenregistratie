{
    "Id": null,
    "Name": "AdminUpdateUserFlow",
    "Version": "1.0",
    "Status": "Active",
    "StartStepId": "update-user-step",
    "ErrorStepId": "error-step",
    "Steps": {
        "update-user-step": {
            "Id": "update-user-step",
            "Type": "QueryDatabase",
            "Parameters": {
                "QueryType": "Update",
                "QueryTextType": "Text",
                "Query": "UPDATE Users SET Role = @Role, Disabled = @Disabled WHERE Id = @Id",
                "Parameters": {
                    "Role": "${event.data.role}",
                    "Disabled": "${event.data.disabled}",
                    "Id": "${event.data.id}"
                }
            },
            "Alias": "updated",
            "NextStepId": "send-success-step",
            "AuthenticationId": 0
        },
        "send-success-step": {
            "Id": "send-success-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "AdminUserUpdated",
                "Data": {
                    "Message": "User updated successfully",
                    "Id": "${event.data.id}"
                }
            },
            "NextStepId": null
        },
        "error-step": {
            "Id": "error-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "AdminUserUpdateFailed",
                "Data": {
                    "Message": "Failed to update user",
                    "Status": "Failed",
                    "Error": "${error}"
                }
            },
            "NextStepId": null
        }
    },
    "Events": [
        {
            "Id": null,
            "Name": "AdminUpdateUser",
            "Version": "1.0",
            "Status": "Active",
            "Roles": [
                "Admin"
            ],
            "Validation": []
        }
    ]
}