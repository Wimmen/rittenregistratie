{
    "Id": null,
    "Name": "AdminGetMigrationsFlow",
    "Version": "1.0",
    "Status": "Active",
    "StartStepId": "get-migrations-step",
    "ErrorStepId": "error-step",
    "Steps": {
        "get-migrations-step": {
            "Id": "get-migrations-step",
            "Type": "QueryDatabase",
            "Parameters": {
                "QueryType": "Select",
                "QueryTextType": "Dynamic",
                "Query": [{
                    "Sql": "SELECT *",
                    "Part": "Select"
                },
                {
                    "Sql": "FROM Migrations",
                    "Part": "From"
                },
                {
                    "Sql": "WHERE Name LIKE @Search",
                    "Part": "Where",
                    "Conditions": "@Search != %%"
                },
                {
                    "Sql": "ORDER BY Name ASC",
                    "Part": "OrderBy"
                },
                {
                    "Sql": "OFFSET @Offset ROWS FETCH NEXT @Limit ROWS ONLY",
                    "Part": "Limit"
                }],
                "Parameters": {
                    "Search": "%${event.search}%",
                    "Offset": "${event.offset}",
                    "Limit": "${event.limit}"
                }
            },
            "Alias": "migrations",
            "NextStepId": "count-migrations-step",
            "ConnectionId": 0
        },
        "count-migrations-step": {
            "Id": "count-migrations-step",
            "Type": "QueryDatabase",
            "Parameters": {
                "QueryType": "Select",
                "QueryTextType": "Dynamic",
                "Query": [{
                    "Sql": "SELECT COUNT(*) as Total",
                    "Part": "Select"
                },
                {
                    "Sql": "FROM Migrations",
                    "Part": "From"
                },
                {
                    "Sql": "WHERE Name LIKE @Search",
                    "Part": "Where",
                    "Conditions": "@Search != %%"
                }],
                "Parameters": {
                    "Search": "%${event.search}%"
                }
            },
            "Alias": "count",
            "NextStepId": "send-migrations-step",
            "ConnectionId": 0
        },
        "send-migrations-step": {
            "Id": "send-migrations-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "AdminMigrationsList",
                "Data": {
                    "Items": "${migrations}",
                    "Total": "${count.0.Total}",
                    "Offset": "${event.offset}",
                    "Limit": "${event.limit}"
                }
            },
            "NextStepId": null
        },
        "error-step": {
            "Id": "error-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "AdminMigrationsListFailed",
                "Data": {
                    "Message": "Failed to retrieve migrations",
                    "Status": "Failed",
                    "Error": "${error}"
                }
            },
            "NextStepId": null
        }
    },
    "Events": [
        {
            "Id": null,
            "Name": "AdminGetMigrations",
            "Version": "1.0",
            "Status": "Active",
            "Roles": ["Admin"],
            "Validation": []
        }
    ]
}