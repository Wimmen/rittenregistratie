{
  "Id": null,
  "Name": "CreateUserFlow",
  "Version": "1.0",
  "Status": "Active",
  "StartStepId": "get-existing-user-step",
  "ErrorStepId": "error-to-user-step",
  "Steps": {
    "get-existing-user-step": {
      "Id": "get-existing-user-step",
      "Type": "QueryDatabase",
      "Parameters": {
        "QueryType": "Select",
        "QueryTextType": "Text",
        "Query": "SELECT Id FROM Users WHERE Oid = @Oid",
        "Parameters": {
          "Oid": "${principal.userId}"
        }
      },
      "Alias": "UserExists",
      "NextStepId": "check-user-exists-step",
      "AuthenticationId": 0
    },
    "check-user-exists-step": {
      "Id": "check-user-exists-step",
      "Type": "Decision",
      "Parameters": {
        "Condition": "${NOT(EMPTY(UserExists.0.Id))}",
        "TrueStepId": "update-user-step",
        "FalseStepId": "create-user-step"
      },
      "Alias": "UserExistsCheck",
      "NextStepId": "${UserExistsCheck}",
      "AuthenticationId": 0
    },
    "create-user-step": {
      "Id": "create-user-step",
      "Type": "QueryDatabase",
      "Parameters": {
        "QueryType": "Insert",
        "QueryTextType": "Text",
        "Query": "INSERT INTO Users (FirstName, LastName, Email, LastLogin, Oid, Disabled) VALUES (@FirstName, @LastName, @Email, getDate(), @Oid, 0)",
        "Parameters": {
          "FirstName": "${event.data.firstName}",
          "LastName": "${event.data.lastName}",
          "Email": "${event.data.email}",
          "Oid": "${principal.userId}"
        }
      },
      "Alias": "Created",
      "NextStepId": "success-to-user-step",
      "AuthenticationId": 0
    },
    "update-user-step": {
      "Id": "update-user-step",
      "Type": "QueryDatabase",
      "Parameters": {
        "QueryType": "Update",
        "QueryTextType": "Text",
        "Query": "UPDATE Users SET FirstName = @FirstName, LastName = @LastName, Email = @Email, LastLogin = getDate() WHERE Oid = @Oid",
        "Parameters": {
          "FirstName": "${event.data.firstName}",
          "LastName": "${event.data.lastName}",
          "Email": "${event.data.email}",
          "Oid": "${principal.userId}"
        }
      },
      "Alias": "Updated",
      "NextStepId": "success-to-user-step",
      "AuthenticationId": 0
    },
    "success-to-user-step": {
      "Id": "success-to-user-step",
      "Type": "SendMessageToUser",
      "Parameters": {
        "Event": "UserSaved",
        "Data": {
          "Message": "User Save Successful",
          "Status": "Success"
        }
      },
      "NextStepId": null
    },
    "error-to-user-step": {
      "Id": "error-to-user-step",
      "Type": "SendMessageToUser",
      "Parameters": {
        "Event": "UserSaveFailed",
        "Data": {
          "Message": "User Save Failed",
          "Status": "Failed",
          "Error": "${error}"
        }
      },
      "NextStepId": null
    }
  },
  "Events": [
    {
      "Id": null,
      "Name": "CreateUser",
      "Version": "1.0",
      "Status": "Active",
      "Validation": [
        {
          "Check": "${NOT(EMPTY(event.Email))}",
          "Message": "Email is verplicht"
        },
        {
          "Check": "${NOT(EMPTY(event.FirstName))}",
          "Message": "Voornaam is verplicht"
        },
        {
          "Check": "${NOT(EMPTY(event.LastName))}",
          "Message": "Achternaam is verplicht"
        },
        {
          "Check": "${NOT(EMPTY(principal.userId))}",
          "Message": "Gebruiker is verplicht"
        }
      ]
    }
  ]
}