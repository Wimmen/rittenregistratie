{
    "Id": null,
    "Name": "AdminDeleteAuthenticationFlow",
    "Version": "1.0",
    "Status": "Active",
    "Description": "Flow to delete an authentication",
    "StartStepId": "delete-auth-step",
    "ErrorStepId": "error-step",
    "Steps": {
        "delete-auth-step": {
            "Id": "delete-auth-step",
            "Type": "QueryDatabase",
            "Parameters": {
                "QueryType": "Update",
                "QueryTextType": "Text",
                "Query": "DELETE FROM Authentications WHERE Id = @Id",
                "Parameters": {
                    "Id": "${event.data.id}"
                }
            },
            "Alias": "deleted",
            "NextStepId": "send-success-step",
            "AuthenticationId": 0
        },
        "send-success-step": {
            "Id": "send-success-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "AdminAuthenticationDeleted",
                "Data": {
                    "Message": "Authentication deleted successfully",
                    "Id": "${event.data.id}"
                }
            },
            "NextStepId": null
        },
        "error-step": {
            "Id": "error-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "AdminAuthenticationDeleteFailed",
                "Data": {
                    "Message": "Failed to delete authentication",
                    "Status": "Failed",
                    "Error": "${error}"
                }
            },
            "NextStepId": null
        }
    },
    "Events": [
        {
            "Id": null,
            "Name": "AdminDeleteAuthentication",
            "Version": "1.0",
            "Status": "Active",
            "Roles": [
                "Admin"
            ],
            "Validation": [
                {
                    "Check": "${NOT(EMPTY(event.data.id))}",
                    "Message": "Authentication Id is required"
                }
            ]
        }
    ]
}