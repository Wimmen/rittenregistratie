{
    "Id": null,
    "Name": "AdminUpdateRoleFlow",
    "Version": "1.0",
    "Status": "Active",
    "StartStepId": "update-role-step",
    "ErrorStepId": "error-step",
    "Steps": {
        "update-role-step": {
            "Id": "update-role-step",
            "Type": "QueryDatabase",
            "Parameters": {
                "QueryType": "Update",
                "QueryTextType": "Text",
                "Query": "UPDATE Roles SET Name = @Name WHERE Id = @Id",
                "Parameters": {
                    "Name": "${event.data.name}",
                    "Id": "${event.data.id}"
                }
            },
            "Alias": "updated",
            "NextStepId": "send-success-step",
            "AuthenticationId": 0
        },
        "send-success-step": {
            "Id": "send-success-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "AdminRoleUpdated",
                "Data": {
                    "Message": "Role updated successfully",
                    "Id": "${event.data.id}",
                    "Name": "${event.data.name}"
                }
            },
            "NextStepId": null
        },
        "error-step": {
            "Id": "error-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "AdminRoleUpdateFailed",
                "Data": {
                    "Message": "Failed to update role",
                    "Status": "Failed",
                    "Error": "${error}"
                }
            },
            "NextStepId": null
        }
    },
    "Events": [
        {
            "Id": null,
            "Name": "AdminUpdateRole",
            "Version": "1.0",
            "Status": "Active",
            "Roles": [
                "Admin"
            ],
            "Validation": [
                {
                    "Check": "${NOT(EMPTY(event.id))}",
                    "Message": "Role ID is required"
                },
                {
                    "Check": "${NOT(EMPTY(event.name))}",
                    "Message": "Role name is required"
                }
            ]
        }
    ]
}