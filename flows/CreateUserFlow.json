{
  "Id": null,
  "Name": "CreateUserFlow",
  "Version": "1.0",
  "Status": "Active",
  "StartStepId": "get-existing-user-step",
  "ErrorStepId": "error-to-user-step",
  "Steps": {
    "get-existing-user-step": {
      "Id": "get-existing-user-step",
      "Type": "SendDataToDatabase",
      "Parameters": {
        "QueryType": "Select",
        "QueryTextType": "Text",
        "Query": "SELECT Id FROM Users WHERE Oid = @Oid",
        "Parameters": {
          "Oid": "${principal.userId}"
        }
      },
      "Alias": "UserExists",
      "NextStepId": "check-user-exists-step",
      "ConnectionId": 0
    },
    "check-user-exists-step": {
      "Id": "check-user-exists-step",
      "Type": "Decision",
      "Parameters": {
        "Condition": "${UserExists.0.Id} NOT EMPTY",
        "TrueStepId": "update-user-step",
        "FalseStepId": "create-user-step"
      },
      "Alias": "UserExistsCheck",
      "NextStepId": "${UserExistsCheck}",
      "ConnectionId": 0
    },
    "create-user-step": {
      "Id": "create-user-step",
      "Type": "SendDataToDatabase",
      "Parameters": {
        "QueryType": "Insert",
        "QueryTextType": "Text",
        "Query": "INSERT INTO Users (FirstName, LastName, Email, Role, LastLogin, Oid, Disabled) VALUES (@FirstName, @LastName, @Email, 'User', getDate(), @Oid, 0)",
        "Parameters": {
          "FirstName": "${event.firstName}",
          "LastName": "${event.lastName}",
          "Email": "${event.email}",
          "Oid": "${principal.userId}"
        }
      },
      "Alias": "Created",
      "NextStepId": "success-to-user-step",
      "ConnectionId": 0
    },
    "update-user-step": {
      "Id": "update-user-step",
      "Type": "SendDataToDatabase",
      "Parameters": {
        "QueryType": "Update",
        "QueryTextType": "Text",
        "Query": "UPDATE Users SET FirstName = @FirstName, LastName = @LastName, Email = @Email, LastLogin = getDate() WHERE Oid = @Oid",
        "Parameters": {
          "FirstName": "${event.firstName}",
          "LastName": "${event.lastName}",
          "Email": "${event.email}",
          "Oid": "${principal.userId}"
        }
      },
      "Alias": "Updated",
      "NextStepId": "success-to-user-step",
      "ConnectionId": 0
    },
    "success-to-user-step": {
      "Id": "success-to-user-step",
      "Type": "SendMessageToUser",
      "Parameters": {
        "Event": "UserCreationSuccess",
        "Data": {
          "Message": "User Creation Successful",
          "Status": "Success"
        }
      },
      "NextStepId": null
    },
    "error-to-user-step": {
      "Id": "error-to-user-step",
      "Type": "SendMessageToUser",
      "Parameters": {
        "Event": "UserCreationFailed",
        "Data": {
          "Message": "User Creation Failed",
          "Status": "Failed",
          "Error": "${error}"
        }
      },
      "NextStepId": null
    }
  },
  "Events": [
    {
      "Id": null,
      "Name": "CreateUser",
      "Version": "1.0",
      "Status": "Active",
      "Validation": "[event.Email NOT EMPTY, event.FirstName NOT EMPTY, event.LastName NOT EMPTY, principal.userId NOT EMPTY]"
    }
  ]
}
