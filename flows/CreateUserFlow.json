{
  "Id": null,
  "Name": "CreateUserFlow",
  "Version": "1.0",
  "Status": "Active",
  "StartStepId": "create-user-step",
  "ErrorStepId": "error-to-user-step",
  "Steps": {
    "create-user-step": {
      "Id": "create-user-step",
      "Type": "SendDataToDatabase",
      "Parameters": {
        "QueryType": "Insert",
        "QueryTextType": "Text",
        "Query": "INSERT INTO Users (FirstName, LastName, Email, Role, LastLogin, Oid, Disabled) VALUES (@FirstName, @LastName, @Email, 'User', getDate(), @Oid, 0)",
        "Parameters": {
          "FirstName": "{{event.firstName}}",
          "LastName": "{{event.lastName}}",
          "Email": "{{event.email}}",
          "Oid": "{{principal.userId}}"
        }
      },
      "Alias": "Created",
      "NextStepId": "success-to-user-step",
      "ConnectionId": 0
    },
    "success-to-user-step": {
      "Id": "success-to-user-step",
      "Type": "SendMessageToUser",
      "Parameters": {
        "Event": "UserCreationSuccess",
        "Data": {
          "Message": "User Creation Successful",
          "Status": "Success"
        }
      },
      "NextStepId": null
    },
    "error-to-user-step": {
      "Id": "error-to-user-step",
      "Type": "SendMessageToUser",
      "Parameters": {
        "Event": "UserCreationFailed",
        "Data": {
          "Message": "User Creation Failed",
          "Status": "Failed",
          "Error": "{{error}}"
        }
      },
      "NextStepId": null
    }
  },
  "Events": [
    {
      "Id": null,
      "Name": "CreateUser",
      "Version": "1.0",
      "Status": "Active",
      "Validation": "[event.Email NOT EMPTY, event.FirstName NOT EMPTY, event.LastName NOT EMPTY, principal.userId NOT EMPTY]"
    }
  ]
}
