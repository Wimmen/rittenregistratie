{
    "Id": null,
    "Name": "AdminGetUserFlow",
    "Version": "1.0",
    "Status": "Active",
    "StartStepId": "get-user-step",
    "ErrorStepId": "error-step",
    "Steps": {
        "get-user-step": {
            "Id": "get-user-step",
            "Type": "QueryDatabase",
            "Parameters": {
                "QueryType": "Select",
                "QueryTextType": "Text",
                "Query": "SELECT * FROM Users WHERE Id = @Id",
                "Parameters": {
                    "Id": "${event.id}"
                }
            },
            "Alias": "user",
            "NextStepId": "send-user-step",
            "ConnectionId": 0
        },
        "send-user-step": {
            "Id": "send-user-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "AdminUserLoaded",
                "Data": "${user}"
            },
            "NextStepId": null
        },
        "error-step": {
            "Id": "error-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "AdminGetUserFailed",
                "Data": {
                    "Message": "Failed to retrieve user details",
                    "Status": "Failed",
                    "Error": "${error}"
                }
            },
            "NextStepId": null
        }
    },
    "Events": [
        {
            "Id": null,
            "Name": "AdminGetUser",
            "Version": "1.0",
            "Status": "Active",
            "Validation": "[principal.userId NOT EMPTY, event.id NOT EMPTY]"
        }
    ]
}