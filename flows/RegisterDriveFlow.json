{
    "Id": null,
    "Name": "RegisterDriveFlow",
    "Version": "1.0",
    "Status": "Active",
    "StartStepId": "insert-drive-step",
    "ErrorStepId": "error-to-user-step",
    "Steps": {
        "insert-drive-step": {
            "Id": "insert-drive-step",
            "Type": "QueryDatabase",
            "Parameters": {
                "QueryType": "Insert",
                "QueryTextType": "Text",
                "Query": "INSERT INTO Drives (DriveDate, FromLocation, ToLocation, Mileage, Type, UserId, Description, CreatedAt) VALUES (@DriveDate, @FromLocation, @ToLocation, @Mileage, @Type, @UserId, @Description, getDate())",
                "Parameters": {
                    "DriveDate": "${event.data.date}",
                    "FromLocation": "${event.data.from}",
                    "ToLocation": "${event.data.to}",
                    "Mileage": "${event.data.mileage}",
                    "Type": "${event.data.type}",
                    "UserId": "${principal.userId}",
                    "Description": "${event.data.description}"
                }
            },
            "Alias": "DriveInserted",
            "NextStepId": "success-to-user-step",
            "AuthenticationId": 0
        },
        "success-to-user-step": {
            "Id": "success-to-user-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "DriveRegistered",
                "Data": {
                    "Message": "Drive Registered Successfully",
                    "Status": "Success"
                }
            },
            "NextStepId": null
        },
        "error-to-user-step": {
            "Id": "error-to-user-step",
            "Type": "SendMessageToUser",
            "Parameters": {
                "Event": "DriveRegistrationFailed",
                "Data": {
                    "Message": "Drive Registration Failed",
                    "Status": "Failed",
                    "Error": "${error}"
                }
            },
            "NextStepId": null
        }
    },
    "Events": [
        {
            "Id": null,
            "Name": "RegisterDrive",
            "Version": "1.0",
            "Status": "Active",
            "Roles": [
                "User"
            ],
            "Validation": [
                {
                    "Check": "${NOT(EMPTY(event.data.date))}",
                    "Message": "Datum is verplicht"
                },
                {
                    "Check": "${NOT(EMPTY(event.data.from))}",
                    "Message": "Van is verplicht"
                },
                {
                    "Check": "${NOT(EMPTY(event.data.to))}",
                    "Message": "Naar is verplicht"
                },
                {
                    "Check": "${NOT(EMPTY(event.data.mileage))}",
                    "Message": "Kilometerstand is verplicht"
                },
                {
                    "Check": "${NOT(EMPTY(principal.userId))}",
                    "Message": "Gebruiker is onbekend"
                }
            ]
        }
    ]
}